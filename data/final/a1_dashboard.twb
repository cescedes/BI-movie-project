      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1tl1h240xsu7z015kssp41889k2z].[avg:Calculation_3182811429326848:qk]&quot;' value='Imdb Avg. Rating' />
          <alias key='&quot;[federated.1tl1h240xsu7z015kssp41889k2z].[usr:Calculation_3182811478171654:qk]&quot;' value='MovieLens Rating' />
        </aliases>
      </column>
      <column caption='Active Months per Genre' datatype='integer' name='[Calculation_2096768812347393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [genre_name] : COUNTD([month_key]) }' />
      </column>
      <column caption='Engagement Index' datatype='integer' name='[Calculation_2096768812494850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[rating_count] + [tag_count]' />
      </column>
      <column caption='Weighted Avg Rating' datatype='real' name='[Calculation_2096768813051907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rating_count] * [Calculation_3182811431124993]) / SUM([rating_count])' />
      </column>
      <column caption='Active Months' datatype='integer' name='[Calculation_2096837291376640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [movie_key] : COUNTD(IF [rating_count] &gt; 0 THEN [month_key] END) }' />
      </column>
      <column caption='Imdb Avg Rating Float' datatype='real' name='[Calculation_3182811429326848]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='FLOAT(REPLACE(TRIM([imdb_avg_rating]), &quot;,&quot;, &quot;.&quot;))' />
      </column>
      <column caption='Avg Rating Float' datatype='real' name='[Calculation_3182811431124993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(REPLACE(TRIM([avg_rating]), &quot;,&quot;, &quot;.&quot;))' />
      </column>
      <column caption='Release Period' datatype='string' name='[Calculation_3182811433046018]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [release_year] &lt; 1980 THEN &quot;Classic (pre-1980)&quot;&#13;&#10;ELSEIF [release_year] &lt; 2000 THEN &quot;1980s–1990s&quot;&#13;&#10;ELSEIF [release_year] &lt; 2010 THEN &quot;2000s&quot;&#13;&#10;ELSEIF [release_year] &lt; 2020 THEN &quot;2010s&quot;&#13;&#10;ELSE &quot;2020s+&quot;&#13;&#10;END' />
      </column>
      <column caption='Runtime Bucket' datatype='string' name='[Calculation_3182811433185283]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [runtime_minutes] &lt; 90 THEN &quot;Short (&lt;90 min)&quot;&#13;&#10;ELSEIF [runtime_minutes] &lt; 120 THEN &quot;Standard (90–120)&quot;&#13;&#10;ELSEIF [runtime_minutes] &lt; 150 THEN &quot;Long (120–150)&quot;&#13;&#10;ELSE &quot;Epic (150+)&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Movie Engagement' datatype='integer' name='[Calculation_3182811433840644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [title] : SUM([rating_count]) + SUM([tag_count]) }' />
      </column>
      <column caption='MovieLens vs IMDb Rating Gap' datatype='real' name='[Calculation_3182811434434565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([Calculation_3182811429326848]) / 2) - [Calculation_2096768813051907]' />
      </column>
      <column caption='MovieLens Rating x2' datatype='real' name='[Calculation_3182811478171654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2096768813051907] * 2' />
      </column>
      <column caption='Tmdb Popularity Float' datatype='real' name='[Calculation_3182811509633031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(REPLACE(TRIM([tmdb_popularity]), &quot;,&quot;, &quot;.&quot;))' />
      </column>
