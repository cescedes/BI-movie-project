    <worksheet name='KPI_Avg_Rating'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#555555' fontsize='13'>Movies</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_movie_month+' name='federated.1tl1h240xsu7z015kssp41889k2z' />
          </datasources>
          <datasource-dependencies datasource='federated.1tl1h240xsu7z015kssp41889k2z'>
            <column caption='Weighted Avg Rating' datatype='real' name='[Calculation_2096768813051907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rating_count] * [Calculation_3182811431124993]) / SUM([rating_count])' />
            </column>
            <column caption='Avg Rating Float' datatype='real' name='[Calculation_3182811431124993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(REPLACE(TRIM([avg_rating]), &quot;,&quot;, &quot;.&quot;))' />
            </column>
            <column caption='Avg Rating' datatype='string' name='[avg_rating]' role='dimension' type='nominal' />
            <column caption='Rating Count' datatype='integer' name='[rating_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2096768813051907]' derivation='User' name='[usr:Calculation_2096768813051907:qk]' pivot='key' type='quantitative' />
