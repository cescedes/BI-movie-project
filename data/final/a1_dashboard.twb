    <worksheet name='Q1_Lines'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>Top 7 Movies - Engagement Over Time</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_movie_month+' name='federated.1tl1h240xsu7z015kssp41889k2z' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top N Movies' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range granularity='5' max='50' min='5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tl1h240xsu7z015kssp41889k2z'>
            <column caption='Engagement Index' datatype='integer' name='[Calculation_2096768812494850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[rating_count] + [tag_count]' />
            </column>
            <column caption='Release Period' datatype='string' name='[Calculation_3182811433046018]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [release_year] &lt; 1980 THEN &quot;Classic (pre-1980)&quot;&#13;&#10;ELSEIF [release_year] &lt; 2000 THEN &quot;1980s–1990s&quot;&#13;&#10;ELSEIF [release_year] &lt; 2010 THEN &quot;2000s&quot;&#13;&#10;ELSEIF [release_year] &lt; 2020 THEN &quot;2010s&quot;&#13;&#10;ELSE &quot;2020s+&quot;&#13;&#10;END' />
            </column>
            <column caption='Genre Name' datatype='string' name='[genre_name]' role='dimension' type='nominal' />
            <column caption='Month Start' datatype='date' name='[month_start]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_3182811433046018]' derivation='None' name='[none:Calculation_3182811433046018:nk]' pivot='key' type='nominal' />
            <column-instance column='[genre_name]' derivation='None' name='[none:genre_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[title]' derivation='None' name='[none:title:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
            <column caption='Rating Count' datatype='integer' name='[rating_count]' role='measure' type='quantitative' />
            <column caption='Release Year' datatype='integer' name='[release_year]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_2096768812494850]' derivation='Sum' name='[sum:Calculation_2096768812494850:qk]' pivot='key' type='quantitative' />
            <column caption='Tag Count' datatype='integer' name='[tag_count]' role='measure' type='quantitative' />
            <column caption='Title' datatype='string' name='[title]' role='dimension' type='nominal' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
            <column-instance column='[month_start]' derivation='Year' name='[yr:month_start:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1tl1h240xsu7z015kssp41889k2z].[none:Calculation_3182811433046018:nk]'>
            <groupfilter function='level-members' level='[none:Calculation_3182811433046018:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1tl1h240xsu7z015kssp41889k2z].[none:genre_name:nk]'>
            <groupfilter function='level-members' level='[none:genre_name:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1tl1h240xsu7z015kssp41889k2z].[none:title:nk]'>
            <groupfilter count='[Parameters].[Parameter 1]' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([Calculation_2096768812494850])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:title:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
